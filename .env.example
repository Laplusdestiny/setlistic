# Supabase（ブラウザ・サーバー共通。ログインユーザーのJWTで動く）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# マイグレーション専用の直接接続。ユーザー操作の処理では使わない
DATABASE_URL=


# YouTube Data API v3 のキー（任意・無料枠 1日10,000ユニット）。YouTube Music の共有URLから曲情報を取るときに最初に使う。
# 未設定なら watch ページ → oEmbed の順に取得する。サーバー側だけで使うので NEXT_PUBLIC_ を付けない
YOUTUBE_API_KEY=

# RLS 統合テスト用の使い捨て Postgres（本番 Supabase には絶対に向けない）
# docker run -d --rm -p 54329:5432 -e POSTGRES_PASSWORD=pw postgres:17
# TEST_DATABASE_URL=postgres://postgres:pw@localhost:54329/postgres

# Vercel Cron が /api/health を呼ぶときの秘密（Vercel が Authorization: Bearer で付ける）。本番のみ。
CRON_SECRET=
