{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "crons": [{ "path": "/api/health", "schedule": "0 3 * * 1" }],
  "redirects": [
    {
      "source": "/((?!api/health$).*)",
      "has": [{ "type": "host", "value": "setlistic.vercel.app" }],
      "destination": "https://setlistic.laplusdestiny.com/$1",
      "permanent": true
    }
  ]
}
